# Copy to .env and fill in. .env is gitignored.

# --- LLM ---------------------------------------------------------------
# Providers are tried in the order set in config/models.yaml. Any one is
# enough to run; none at all still works via the template fallback.

# Fast, cheap tier. https://console.groq.com/
#
# Up to six calls go out per turn once the domain agents deliberate -- one
# planner, one per active agent, one narrator -- and a single free-tier key
# rate-limits under that. Additional keys are tried in turn; add as many as
# GROQ_API_KEY_2, GROQ_API_KEY_3 and so on.
GROQ_API_KEY=
GROQ_API_KEY_2=

# Unlimited tier via the OpenCode Zen gateway (OpenAI-compatible).
# https://opencode.ai/docs/zen/ -- sign in, add billing, copy the key.
# Model roster (keyless): curl https://opencode.ai/zen/v1/models
# Per-role model ids live in config/models.yaml under `opencode`.
OPENCODE_API_KEY=

# Optional stronger tier. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional offline tier. Install Ollama and pull llama3.1:8b; nothing else
# needed -- the client probes http://localhost:11434 and uses it if present.

# --- Data plane (Phase 2) ----------------------------------------------
# Supabase pooler URL -- port 6543, NOT 5432.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Copernicus Marine, for L4 SST / chlorophyll and the climatology.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
