# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# This file is the TEMPLATE: names, no values. It is the only env file that is
# committed. Never paste a real key here -- a key that reaches git is leaked
# even in a private repo, and history is permanent, so the fix is to rotate the
# key rather than to delete the line.
#
# For CI or a deployment, put the real values in the platform's secret store
# (GitHub: Settings -> Secrets and variables -> Actions), never in the repo.

# --- LLM ---------------------------------------------------------------
# Providers are tried in the order set in config/models.yaml. Any one is
# enough to run; none at all still works via the template fallback.

# Fast, cheap tier. https://console.groq.com/
#
# Up to six calls go out per turn once the domain agents deliberate -- one
# planner, one per active agent, one narrator -- and a single free-tier key
# rate-limits under that. Additional keys are tried in turn; add as many as
# GROQ_API_KEY_2, GROQ_API_KEY_3 and so on.
# NOTE, learned the hard way on 2026-09-07: the free tier meters tokens per
# day PER MODEL, PER ORGANIZATION -- not per key. Three keys from one account
# reported the same org and the same exhausted pool. Extra keys spread burst
# rate; only a key from a DIFFERENT account adds daily quota.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Model tier: free (Zen frees -> Go cheap, default) | fast (grok-4.6 first)
# | paid (kimi-k3 -> deepseek-v4-pro -> grok-4.6). Chains per tier live under
# `tiers:` in config/models.yaml. Needs Go quota for fast/paid.
# ORCA_TIER=fast
# https://opencode.ai/docs/zen/ -- sign in, add billing, copy the key.
# Model roster (keyless): curl https://opencode.ai/zen/v1/models
# Per-role model CHAINS live in config/models.yaml under `opencode`.
# NOTE: *-contributor-free ids are free because prompts/completions train
# future Meta models (Zen docs, Privacy). Fine for fishermen queries; use
# paid siblings for anything sensitive.
OPENCODE_API_KEY=

# Second Zen gateway (https://opencode.ai/zen/go/v1, both transports).
# Chain under `opencode-go` in config/models.yaml; tried after Zen.
OPENCODE_GO_API_KEY=

# Optional stronger tier. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional offline tier. Install Ollama and pull llama3.1:8b; nothing else
# needed -- the client probes http://localhost:11434 and uses it if present.

# --- Data plane (Phase 2) ----------------------------------------------
# Supabase pooler URL -- port 6543, NOT 5432.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Copernicus Marine, for L4 SST / chlorophyll and the climatology.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Strongest chain by default (owner call 2026-09-08): restarts land on paid. paid/free/fast
ORCA_TIER=

# Modal, for deploying the backend. Used by the modal CLI at deploy time
# only -- the app never reads these at runtime.
modal_token_id=
modal_token_secret=

# Comma-separated origins allowed to call the deployed API (the Vercel
# frontend, and any preview URLs). Read by deploy/modal_app.py. Empty means
# no CORS headers, which is correct for same-origin and for curl, and blocks
# a browser page on another domain from spending this deployment's tokens.
ORCA_ALLOWED_ORIGINS=

# Shared secret for the deployed API. Lives on the orca-llm Modal secret and,
# as VITE_ORCA_API_KEY, in the Vercel build environment. The deployment fails
# CLOSED without it: an auth control that quietly does nothing when
# misconfigured is worse than none, because it is believed in.
ORCA_API_KEY=
